        "jsonBody": "={\n  \"model\": \"openai/gpt-oss-20b\",\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"You are a weather assistant. Create a weather report from the provided weather data ONLY. Keep the response under 100 words.STRICTLY give the summary report from the given Context only and Draft the Message in a Polite way.\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"Context-{{ $json.output.replace(/\\n/g, '\\\\n') }}\"\n    }\n  ],\n  \"temperature\": 0.2\n}\n",

      "parameters": {
        "jsCode": "// Extract the JSON content from Groq API response\nconst content = $input.first().json.choices?.[0]?.message?.content;\n\n// Parse and return\ntry {\n  const parsed = JSON.parse(content);\n  return [{ json: parsed }];\n} catch (err) {\n  return [{\n    json: {\n      error: true,\n      message: \"Failed to parse LLM response\",\n      raw: content\n    }\n  }];\n}\n"
      },
